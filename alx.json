{
  "id": "alemonx-network",
  "name": "网络管理",
  "version": "0.0.1",
  "description": "面向线上服务器的通用网络治理：安全查看并管理连接、接口、地址、路由、DNS、防火墙与可选的端口转发。",
  "platforms": [
    "darwin",
    "linux",
    "windows"
  ],
  "runtime": "binary",
  "entry": {
    "darwin-arm64": "dist/alemonx-network-darwin-arm64",
    "darwin-amd64": "dist/alemonx-network-darwin-amd64",
    "linux-amd64": "dist/alemonx-network-linux-amd64",
    "windows-amd64": "dist/alemonx-network-windows-amd64.exe"
  },
  "development": {
    "runtime": "go",
    "entry": {
      "go": "runner"
    },
    "web": {
      "mode": "dev-server",
      "root": "web",
      "build": {
        "program": "yarn",
        "args": ["--cwd", "frontend", "build"]
      },
      "dev": {
        "program": "yarn",
        "args": ["--cwd", "frontend", "dev", "--host", "127.0.0.1", "--port", "${ALX_PLUGIN_DEV_PORT}"]
      },
      "healthPath": "/",
      "hmr": true
    }
  },
  "web": {
    "root": "web"
  },
  "statusActions": [
    "capabilities",
    "snapshot",
    "firewall-status"
  ],
  "privilegedOperations": [
    {
      "action": "firewall-set",
      "runnerAction": "firewall-set",
      "planAction": "plan",
      "title": "启用或停用系统防火墙",
      "description": "网络插件将按已确认的变更计划启用或停用系统防火墙。停用会让本机暴露在公网入站流量下。",
      "authorization": "native",
      "platforms": ["linux", "windows"]
    },
    {
      "action": "apply-plan",
      "runnerAction": "apply-approved-plan",
      "planAction": "plan",
      "title": "授权网络变更",
      "description": "网络插件将按已确认的变更计划修改本机网络配置。",
      "authorization": "native",
      "platforms": ["darwin", "linux", "windows"]
    },
    {
      "action": "undo-last",
	  "runnerAction": "undo-approved",
	  "useLatestAudit": true,
      "title": "授权撤销网络变更",
      "description": "网络插件将撤销最近一项支持恢复的网络变更。",
      "authorization": "native",
      "platforms": ["darwin", "linux", "windows"]
    }
  ],
  "navigation": {
    "label": "网络",
    "icon": "network",
    "order": -100
  }
}
